{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "划词查词",
  "version": "0.1.0",
  "identifier": "uno.eugen.eng-day2up.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "popup",
        "create": false,
        "url": "popup.html",
        "title": "查词",
        "width": 380,
        "height": 460,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": true
      },
      {
        "label": "settings",
        "create": false,
        "url": "settings.html",
        "title": "划词查词 · 设置",
        "width": 640,
        "height": 760,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
