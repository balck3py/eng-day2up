{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "弹窗与设置窗口：事件、设置存储、开机自启、LLM 请求（端点由用户配置，放开 http/https）",
  "windows": ["popup", "settings"],
  "permissions": [
    "core:default",
    "store:default",
    "autostart:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*:*" }, { "url": "https://*:*" }, { "url": "http://*" }, { "url": "https://*" }]
    }
  ]
}
