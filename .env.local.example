# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ollama（Plan 2 使用）
OLLAMA_BASE_URL=
OLLAMA_TOKEN=
OLLAMA_MODEL=

# 云端兜底，OpenAI 兼容接口（Plan 2 使用）
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_MODEL=

# 每用户每日翻译配额（Plan 2 使用）
DAILY_QUOTA=200

# 邮箱白名单：逗号分隔，大小写不敏感。未配置或空字符串 = 不限制（保持现状）。
ALLOWED_EMAILS=

# E2E 测试账号（本地，勿上生产）—— Playwright 用它走登录表单
E2E_EMAIL=
E2E_PASSWORD=
# 可选：覆盖 E2E 目标地址，默认 http://localhost:3001
E2E_BASE_URL=
